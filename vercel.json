{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://waymate-backend-g17d.onrender.com/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://waymate-backend-g17d.onrender.com/socket.io/$1"
    },
    {
      "source": "/socket.io",
      "destination": "https://waymate-backend-g17d.onrender.com/socket.io"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
