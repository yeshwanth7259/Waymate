{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "express"
    },
    "admin": {
      "root": "waymate-launch-v2/admin",
      "framework": "vite"
    },
    "waymate-backend": {
      "root": "waymate-launch-v2/backend",
      "framework": "express",
      "buildCommand": "npm ci --include=dev && npx prisma generate && npm run build"
    },
    "web": {
      "root": "waymate-launch-v2/web",
      "framework": "vite"
    },
    "admin-2": {
      "root": "waymate-platform/admin",
      "framework": "vite"
    },
    "backend-2": {
      "root": "waymate-platform/backend",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "waymate-backend"
      }
    },
    {
      "source": "/socket.io/(.*)",
      "destination": {
        "service": "waymate-backend"
      }
    },
    {
      "source": "/socket.io",
      "destination": {
        "service": "waymate-backend"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
