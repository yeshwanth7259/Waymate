{
  "expo": {
    "name": "Waymate",
    "slug": "waymate",
    "owner": "yeshwanthkumar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/waymate_logo_official.jpg",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.waymate.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/waymate_logo_official.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDmIJKad7eoeTmc0DZ1_Qyp1VM5bF_0ubg"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "530d5b68-c6ba-4321-a0b7-5786f79dcef4"
      }
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
