NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&schema=waymate_v2
CORS_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=your-project-id
# Option A: local service-account credentials. Download the JSON privately from
# Firebase Console → Project settings → Service accounts. Never commit that JSON.
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
# Option B: use Application Default Credentials (gcloud ADC locally or the
# attached service account on Google Cloud). Never use the Auth emulator in production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
DOCUMENT_STORAGE=firebase
LOCAL_UPLOAD_DIR=./uploads
ADMIN_UIDS=your-admin-firebase-uid
OMNIROUTE_BASE_URL=https://your-omniroute-host.example/v1
OMNIROUTE_API_KEY=server-side-omniroute-key
OMNIROUTE_MODEL=provider/model
